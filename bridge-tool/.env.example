# ==============================================================================
# XRPL -> XRPL EVM Sidechain Bridge Configuration (100% Testnet - Zero Real Money)
# ==============================================================================

# 1. Your Destination MetaMask Address on the XRPL EVM Sidechain (starts with "0x...")
# This is where your testnet XRP gas will land on the EVM Sidechain.
EVM_DESTINATION_ADDRESS=0x...

# NOTE: For security, your XRPL_SEED is NOT stored here! 
# You pass your seed directly in the command line when executing the bridge:
#   npm run bridge <YOUR_XRPL_SEED> [amount]

# 3. Amount of Testnet XRP to Bridge (e.g. 25)
BRIDGE_AMOUNT_XRP=25

# 4. Axelar Relayer Fee in drops (Default: 150000 drops = 0.15 testnet XRP)
# Deducted from your testnet XRP to reward testnet cross-chain relayer validators.
BRIDGE_GAS_FEE_DROPS=150000

# 5. Automatically watch and poll your EVM address until funds arrive (true / false)
WATCH_FOR_CONFIRMATION=true
